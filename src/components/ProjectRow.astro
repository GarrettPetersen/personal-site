---
import ProjectLinks from "./ProjectLinks.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{project.tier === "compact" ? (
  <article class:list={["project-line", `project-line--${project.id}`]} id={project.id}>
    <div class="project__index" aria-hidden="true">{project.index}</div>
    <a class="project-line__visual" href={project.projectUrl} target="_blank" rel="noreferrer" tabindex="-1">
      <img src={project.image.src} alt="" loading="lazy" decoding="async" />
    </a>
    <div class="project-line__title">
      <div class="project__meta">
        <span>{project.category}</span>
        <span>{project.status}</span>
      </div>
      <h3>{project.name}</h3>
    </div>
    <p class="project__thesis">{project.thesis}</p>
    <ProjectLinks project={project} />
  </article>
) : (
  <article class:list={["project", `project--${project.tier}`, `project--${project.id}`]} id={project.id}>
    <div class="project__index" aria-hidden="true">{project.index}</div>

    <a class="project__visual" href={project.projectUrl} target="_blank" rel="noreferrer" tabindex="-1">
      <img src={project.image.src} alt={project.image.alt} loading="lazy" decoding="async" />
    </a>

    <div class="project__content">
      <div class="project__meta">
        {project.tier === "primary" && <span class="project__focus">Primary focus</span>}
        <span>{project.category}</span>
        <span>{project.status}</span>
      </div>
      <h3>{project.name}</h3>
      <p class="project__thesis">{project.thesis}</p>
      <p class="project__description">{project.description}</p>

      {project.tier === "primary" && (
        <ul class="project__stack" aria-label="Technologies and disciplines">
          {project.technologies.map((technology) => <li>{technology}</li>)}
        </ul>
      )}

      <ProjectLinks project={project} />
    </div>
  </article>
)}
