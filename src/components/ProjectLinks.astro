---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const sameDestination = project.projectUrl === project.sourceUrl;
---

<div class="project__links">
  <a class="text-link text-link--primary" href={project.projectUrl} target="_blank" rel="noreferrer">
    {project.projectLabel}
    <span aria-hidden="true">↗</span>
  </a>
  {!sameDestination && (
    <a class="text-link" href={project.sourceUrl} target="_blank" rel="noreferrer">
      Source
      <span aria-hidden="true">↗</span>
    </a>
  )}
</div>
