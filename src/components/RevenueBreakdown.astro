---
import { formatDate } from "../lib/desk.mjs";
import { formatMoney, summarizeRevenue } from "../lib/revenue.mjs";
import type { RevenueStream } from "../lib/revenue.mjs";
interface Props { streams: RevenueStream[] }
const { streams } = Astro.props;
const summary = summarizeRevenue(streams);
const period = (start: string, end: string) => `${formatDate(start)}–${formatDate(end, { month: "short", day: "numeric", year: "numeric" })}`;
---

<section class="desk-earnings" aria-labelledby="earnings-title" id="revenue">
  <div class="desk-section-heading"><h2 id="earnings-title">Revenue</h2><span>Before income tax & costs</span></div>
  <div class="desk-earnings__layout">
    <div class="desk-earnings__total">
      {summary.totals.length === 0 ? <><p>Reported total</p><strong>—</strong><span>Awaiting revenue reports</span></> : summary.totals.map((total) => <div>
        <p>{summary.missing > 0 || summary.totals.length > 1 ? "Reported subtotal" : "Reported total"} · {total.currency}</p>
        <strong>{formatMoney(total.amountCents, total.currency)}</strong>
        <span>{period(total.periodStart, total.periodEnd)}<br />{total.basis === "estimated" ? "Estimated" : "Finalized"} developer earnings</span>
      </div>)}
      <small>{summary.reported} of {streams.length} revenue sources reported</small>
    </div>
    <dl class="desk-earnings__streams">
      {streams.map((stream) => <div>
        <dt>{stream.projectId ? <a href={`#${stream.projectId}`}>{stream.label}</a> : stream.label}</dt>
        <dd>{stream.report ? formatMoney(stream.report.amountCents, stream.report.currency) : "Not reported"}</dd>
        <dd class="desk-earnings__context">{stream.report ? <>{period(stream.report.periodStart, stream.report.periodEnd)} · {stream.report.currency} · {stream.report.basis === "estimated" ? "Estimated" : "Finalized"}<br />Checked {formatDate(stream.report.observedAt.slice(0, 10))}. {stream.note}</> : stream.note}</dd>
      </div>)}
    </dl>
  </div>
  <p class="desk-earnings__note">{summary.missing > 0 && "Partial coverage. "}Excludes scenarios and pending grants.</p>
</section>

<style>
  .desk-earnings { margin-bottom: 1.25rem; padding: 1.4rem 1.7rem; border: 1px solid var(--desk-line); border-radius: .65rem; }
  .desk-section-heading { margin-bottom: 1.1rem; }
  .desk-earnings__layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 2rem; }
  .desk-earnings__total { display: grid; align-content: start; gap: .3rem; }
  .desk-earnings__total > div + div { margin-top: 1rem; }
  .desk-earnings__total p { margin: 0 0 .25rem; font-size: .65rem; color: var(--desk-muted); }
  .desk-earnings__total strong { display: block; font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: 1.2; font-weight: 610; letter-spacing: -.055em; font-variant-numeric: tabular-nums; }
  .desk-earnings__total span { display: block; margin-top: .3rem; font-size: .68rem; color: var(--desk-muted); }
  .desk-earnings__total small { margin-top: .5rem; font-size: .59rem; color: var(--desk-muted); }
  .desk-earnings__streams { margin: 0; }
  .desk-earnings__streams > div { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1rem; padding-block: .65rem; border-bottom: 1px solid var(--desk-line); }
  .desk-earnings__streams > div:first-child { padding-top: 0; }
  .desk-earnings__streams > div:last-child { border-bottom: 0; padding-bottom: 0; }
  dt { font-size: .73rem; font-weight: 520; }
  dt a { text-decoration: none; text-underline-offset: .2em; }
  dt a:hover { text-decoration: underline; }
  dd { margin: 0; font-size: .73rem; font-variant-numeric: tabular-nums; }
  dd.desk-earnings__context { grid-column: 1 / -1; margin-top: .25rem; color: var(--desk-muted); font-size: .61rem; }
  .desk-earnings__note { margin: 1rem 0 0; color: var(--desk-muted); font-size: .6rem; }
  @media (max-width: 760px) {
    .desk-earnings { padding: 1.1rem; }
    .desk-earnings__layout { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .desk-earnings__total strong { font-size: 2.3rem; }
    .desk-earnings__streams > div:first-child { border-top: 1px solid var(--desk-line); padding-top: .8rem; }
    .desk-section-heading > span { max-width: 9rem; }
  }
</style>
