---
import "@fontsource-variable/geologica";
import snapshot from "../data/desk.json";
import kdp from "../data/kdp.json";
import RevenueScenario from "../components/RevenueScenario.astro";
import RevenueBreakdown from "../components/RevenueBreakdown.astro";
import DecisionBoard from "../components/DecisionBoard.astro";
import KdpReport from "../components/KdpReport.astro";
import DailyBoard from "../components/DailyBoard.astro";
import TaskList from "../components/TaskList.astro";
import { taskLanes } from "../lib/tasks.mjs";
import { validateDesk, localDate, formatDate, formatChecked, isStale, daysBetween, monthCells } from "../lib/desk.mjs";
import { validateKdpReport } from "../lib/kdp.mjs";
import "../styles/global.css";
import "../styles/desk.css";
const data=validateDesk(snapshot) as typeof snapshot;
validateKdpReport(kdp);
const today=localDate();
const lanes = taskLanes(data.tasks, data.dailyPlan) as Record<'active'|'waiting'|'backburner',(typeof data.tasks)[number][]>;
const archiveGroups=[{title:'On hold',projects:data.archive.filter(p=>p.status==='On hold')},{title:'Shipped & reference',projects:data.archive.filter(p=>p.status!=='On hold')}];
const launch=data.events.find(e=>e.id==='marque-launch')!;
const daysToLaunch=daysBetween(today,launch.date);
const year=Number(today.slice(0,4)),month=Number(today.slice(5,7))-1;
const monthLabel=(y:number,m:number)=>new Intl.DateTimeFormat('en-CA',{timeZone:'UTC',month:'long',year:'numeric'}).format(new Date(Date.UTC(y,m,1,12)));
const counts=new Intl.NumberFormat('en-CA');
const sortedEvents=[...data.events].sort((a,b)=>a.date.localeCompare(b.date));
const upcomingEvents=sortedEvents.filter(e=>e.date>=today);
const healthLabels:Record<string,string>={attention:'Needs attention',moving:'In progress',exploring:'Exploring'};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="description" content="Projects, earnings and the next decisions." />
  <meta name="theme-color" content="#ffffff" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href="https://garrettpetersen.com/desk/" /><title>Project desk — Garrett Petersen</title>
</head>
<body class="desk-page">
  <a class="skip-link" href="#desk-main">Skip to dashboard</a>
  <header class="desk-header"><a class="identity" href="/" aria-label="Garrett Petersen, home"><span class="identity__mark" aria-hidden="true"><span>G</span><span>P</span></span><span class="identity__name">Garrett Petersen</span></a><nav aria-label="Dashboard"><a href="#daily-title">Today</a><a href="#decisions-title">Projects</a><a href="#calendar-title">Calendar</a></nav><a class="desk-home" href="/">Back to site ↗</a></header>
  <main id="desk-main" class="desk-shell">
    <section class="desk-intro"><div><h1>Project desk.</h1><p>{data.brief}</p></div><div class="desk-freshness" data-reviewed-at={data.reviewedAt}><span class:list={['check-state',{'check-state--stale':isStale(data.reviewedAt)}]} data-check-state>{isStale(data.reviewedAt)?'Review overdue':'Reviewed'}</span><time datetime={data.reviewedAt}>{formatChecked(data.reviewedAt)} Pacific</time><span>Daily check-in · 9 a.m.</span></div></section>
    <DailyBoard />
    <section class="desk-pulse" aria-label="Current signals">
      <div class="desk-launch" data-launch-date={launch.date}><div data-launch-count class="desk-launch__days">{daysToLaunch>0?daysToLaunch:daysToLaunch===0?'Today':'Past date'}<span>{daysToLaunch>0?'days to launch':daysToLaunch===0?'Launch day':'Confirm outcome'}</span></div><a href={launch.sourceUrl!}>M&R · {formatDate(launch.date,{month:'short',day:'numeric',year:'numeric'})}</a></div>
      {data.metrics.map(metric=><article class="desk-signal" data-observed-at={metric.observedAt}><span>{metric.label}</span><strong>{metric.id==='wishlist-week'&&'+'}{counts.format(metric.value)}</strong><small>{metric.note}<br />As of {formatDate(localDate(new Date(metric.observedAt)))}<span class="desk-old" data-metric-stale hidden={!isStale(metric.observedAt)}> · Older snapshot</span></small></article>)}
    </section>
    <details class="desk-outlook"><summary><span>Portfolio outlook</span><small>Revenue, milestones & effort</small></summary><DecisionBoard /></details>
    <RevenueBreakdown streams={data.revenue} />
    <div class="desk-columns">
      <div class="desk-main-column">
        <KdpReport />
        <details class="desk-tool"><summary><span>Launch calculator</span></summary><RevenueScenario /></details>
        <section class="desk-actions" aria-labelledby="actions-title"><div class="desk-section-heading"><h2 id="actions-title">Next in line</h2><span>{lanes.active.length} open</span></div>
          <TaskList tasks={lanes.active} />
        </section>
        <details class="desk-task-shelf" id="waiting"><summary><span>Waiting on others</span><small>{lanes.waiting.length}</small></summary><TaskList tasks={lanes.waiting} /></details>
        <details class="desk-task-shelf" id="backburner"><summary><span>Backburner</span><small>{lanes.backburner.length} · when you choose a break</small></summary><p>Optional work. Reconsider after launch week; no catch-up obligation.</p><TaskList tasks={lanes.backburner} /></details>
        <section class="desk-context" aria-labelledby="context-title"><div class="desk-section-heading"><h2 id="context-title">Project context</h2></div>
          {data.projects.map(project=><details class="desk-project" id={project.id}><summary><span>{project.name}<small>{project.stage}</small></span><span class={`desk-status desk-status--${project.health}`}>{healthLabels[project.health]}</span></summary><div class="desk-project__body" id={`${project.id}-context`}><p>{project.summary}</p><dl><div><dt>Blocker</dt><dd>{project.blocker}</dd></div><div><dt>Next</dt><dd>{project.next}</dd></div></dl>{project.id==='marque-and-reprisal'&&<div class="desk-platform"><h3>After Steam: mobile & consoles</h3><p>{data.platformExpansion.model}</p><p>{data.platformExpansion.timing}</p><p>{data.platformExpansion.gates}</p></div>}{project.group==='prototype'&&<p>{data.prototypeStrategy.approach} {data.prototypeStrategy.decision}</p>}<div class="desk-project__bottom">{project.url&&<a href={project.url}>Project site</a>}{project.activity&&<span>Latest code {formatDate(localDate(new Date(project.activity.lastCommitAt)))}</span>}</div></div></details>)}
        </section>
        {archiveGroups.map(group=><details class="desk-archive"><summary>{group.title}<span>{group.projects.length}</span></summary><ul>{group.projects.map(project=><li><div>{project.url?<a href={project.url}>{project.name}</a>:<span>{project.name}</span>}{project.description&&<p>{project.description}</p>}</div><small>{project.status}</small></li>)}</ul></details>)}
      </div>
      <aside class="desk-side-column" aria-label="Calendar and source checks">
          <section class="desk-calendar desk-section" aria-labelledby="calendar-title" data-calendar data-year={year} data-month={month}>
            <div class="desk-section-heading"><h2 id="calendar-title">Calendar</h2><a href="/desk.ics" download>Export .ics</a></div>
            <div class="desk-month-nav">
              <button type="button" aria-label="Previous month" data-month-step="-1" hidden>‹</button>
              <h3 data-month-label aria-live="polite">{monthLabel(year, month)}</h3>
              <button type="button" aria-label="Next month" data-month-step="1" hidden>›</button>
            </div>
            <div class="desk-calendar-week" aria-hidden="true">{["M", "T", "W", "T", "F", "S", "S"].map((day) => <span>{day}</span>)}</div>
            <div class="desk-calendar-grid" data-calendar-grid>
              {monthCells(year, month).map((date) => date ? <span class:list={["desk-day", { "desk-day--today": date === today, "desk-day--event": data.events.some((event) => event.date === date) }]}>{Number(date.slice(-2))}</span> : <span />)}
            </div>
            <p class="desk-calendar-key"><span></span> Confirmed <span></span> Tentative</p>
            <div class="desk-agenda" data-agenda aria-live="polite">
              {sortedEvents.map((event) => <article data-event-date={event.date} hidden={event.date < today} class:list={["desk-event", { "desk-event--confirmed": event.kind === "confirmed" }]}>
                <time datetime={event.date}>{formatDate(event.date,event.date.slice(0,4)===today.slice(0,4)?{month:"short",day:"numeric"}:{month:"short",day:"numeric",year:"numeric"})}</time>
                <div><h3>{event.title}</h3><span>{event.kind === "confirmed" ? "Confirmed" : "Tentative"}</span>
                  <details><summary>Details</summary><p>{event.note}</p>{event.sourceUrl && <a href={event.sourceUrl}>Source</a>}</details>
                </div>
              </article>)}
              <p data-agenda-empty hidden={upcomingEvents.length > 0}>No upcoming dates recorded.</p>
            </div>
            <button class="desk-reset-calendar" type="button" data-calendar-reset hidden>Show upcoming dates</button>
          </section>
        <details class="desk-sources"><summary>Sources</summary><ul>{data.sources.map(source=><li><strong>{source.label}</strong><time datetime={source.checkedAt}>{formatChecked(source.checkedAt)} Pacific</time><p>{source.note}</p></li>)}</ul></details>
      </aside>
    </div>
    <footer class="desk-footer"><a href="/">garrettpetersen.com</a></footer>
  </main>
  <div id="desk-calendar-data" data-events={JSON.stringify(data.events)} hidden></div>
  <script src="../scripts/desk.ts"></script>
</body>
</html>
