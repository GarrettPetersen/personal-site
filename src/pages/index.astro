---
import "@fontsource-variable/geologica";
import ProjectIndex from "../components/ProjectIndex.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
import "../styles/global.css";

const title = "Garrett Petersen — Economist and Data Scientist";
const description =
  "Data leader and scientist with a PhD in Economics, focused on blockchain/DeFi and prediction market data systems.";
const primaryProjects = projects.filter((project) => project.tier === "primary");
const mediumProjects = projects.filter((project) => project.tier === "medium");
const compactProjects = projects.filter((project) => project.tier === "compact");
const secondaryProjects = [...mediumProjects, ...compactProjects];
const socialLinks = [
  { label: "X", url: "https://x.com/GarrettPetersen" },
  { label: "LinkedIn", url: "https://www.linkedin.com/in/garrett-petersen-b875034b" },
  { label: "YouTube", url: "https://www.youtube.com/@GarrettPetersen" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f7f5" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://garrettpetersen.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://garrettpetersen.com/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to work</a>

    <header class="site-header">
      <a class="identity" href="#top" aria-label="Garrett Petersen, home">
        <span class="identity__mark" aria-hidden="true">
          <span>G</span><span>P</span>
        </span>
        <span class="identity__name">Garrett Petersen</span>
      </a>

      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="header-actions">
        <a class="header-link header-link--resume" href="/resume.pdf" target="_blank">
          Résumé <span aria-hidden="true">↗</span>
        </a>
        <a class="header-link" href="https://github.com/GarrettPetersen" target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">Garrett Petersen</p>
          <h1 id="hero-title">
            Economist and<br />
            <em>data scientist.</em>
          </h1>
          <p class="hero__intro">
            Data leader and scientist with a PhD in Economics, focused on blockchain/DeFi and prediction market data systems.
          </p>
          <a class="hero__jump" href="#work">
            Explore the work
            <span class="hero__jump-line" aria-hidden="true"></span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>

        <ProjectIndex featured={primaryProjects} secondary={secondaryProjects} />
      </section>

      <section class="work" id="work" aria-label="Selected work">
        <div class="project-list project-list--primary">
          {primaryProjects.map((project) => <ProjectRow project={project} />)}
        </div>

        <section class="work-tier" aria-labelledby="current-projects-title">
          <h3 class="work-tier__title" id="current-projects-title">Games and products</h3>
          <div class="project-grid">
            {mediumProjects.map((project) => <ProjectRow project={project} />)}
          </div>
        </section>

        <section class="work-tier" aria-labelledby="other-work-title">
          <h3 class="work-tier__title" id="other-work-title">Other work</h3>
          <div class="project-lines">
            {compactProjects.map((project) => <ProjectRow project={project} />)}
          </div>
        </section>
      </section>

      <section class="about" id="about" aria-labelledby="about-title">
        <div class="about__label">
          <p class="eyebrow">About</p>
          <div class="about__seal" aria-hidden="true">
            <span>GP</span>
            <svg viewBox="0 0 100 100">
              <path id="seal-path" d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0" fill="none" />
              <text>
                <textPath href="#seal-path" startOffset="1%">ECONOMICS · SOFTWARE · GAMES · RESEARCH · </textPath>
              </text>
            </svg>
          </div>
        </div>

        <div class="about__copy">
          <h2 id="about-title">I build production analytics platforms and decision models end-to-end.</h2>
          <div class="about__columns">
            <p>
              Experience spans data engineering, applied econometrics, and production analytics for fast-moving crypto market environments.
            </p>
            <p>
              I ran and hosted the <a href="https://economicsdetective.com/" target="_blank" rel="noreferrer">Economics Detective</a> podcast and blog from 2014 to 2021.
            </p>
          </div>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-title">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">Contact me</h2>
        <button class="contact__email" type="button" data-email="Z2FycmV0dC5tLnBldGVyc2VuQGdtYWlsLmNvbQ==">
          Email me
          <span aria-hidden="true">↗</span>
        </button>
        <noscript>
          <a class="text-link text-link--primary" href="/resume.pdf">Contact details in résumé <span aria-hidden="true">↗</span></a>
        </noscript>
        <nav class="contact__socials" aria-label="Social profiles">
          <ul>
            {socialLinks.map((social) => (
              <li>
                <a href={social.url} target="_blank" rel="noreferrer">
                  {social.label}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </section>
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Garrett Petersen</p>
      <p>Economist and Data Scientist</p>
      <a href="#top">Back to top ↑</a>
    </footer>

    <script>
      const emailButton = document.querySelector(".contact__email");
      if (!(emailButton instanceof HTMLButtonElement)) {
        throw new Error("Email button is missing");
      }

      const encodedEmail = emailButton.dataset.email;
      if (!encodedEmail) {
        throw new Error("Email address is missing");
      }

      emailButton.addEventListener("click", () => {
        window.location.href = `mailto:${window.atob(encodedEmail)}`;
      });
    </script>
  </body>
</html>
